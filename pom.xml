<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>
    <groupId>com.hnkjzyxy</groupId>
    <artifactId>assessment-device</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Assessment Device</name>
    <description>智能门锁与智能班牌独立工程，JDK21 / Spring Boot3.5.7 基础设施。</description>

    <!-- 参照 DriftingLeaves：公共工具、数据模型、统一业务服务三个模块。
         Controller、Service、Mapper 均位于 assessment-server，不再拆成独立模块。
         范围依据原项目 doc/智能门锁与智能班牌新项目接口文档-JDK21-SpringBoot3.5.7.md：
         教室、课表、考试、占用排程、门锁、任务回执、操作记录、门禁密码；
         普通登录/验证码/退出/用户信息仍由原认证服务提供。 -->
    <modules>
        <module>assessment-common</module>
        <module>assessment-pojo</module>
        <module>assessment-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.5.7</spring-boot.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <druid.version>1.2.28</druid.version>
        <jjwt.version>0.13.0</jjwt.version>
        <hutool.version>5.8.47</hutool.version>
        <fastjson2.version>2.0.65</fastjson2.version>
        <door-access-io.version>1.0</door-access-io.version>
        <!-- Spring、Security、Jackson、MySQL、Redis/Lettuce、Quartz、Netty、
             Lombok 与 Maven 插件版本继承精确的 Spring Boot 3.5.7 BOM/Parent。
             不覆盖为其他 Boot 补丁版本，不引入考核导出/巡查/博客专用依赖。 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.hnkjzyxy</groupId>
                <artifactId>assessment-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hnkjzyxy</groupId>
                <artifactId>assessment-pojo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 不导入 JJWT BOM：其 Jackson 管理项会覆盖 Boot 的版本。 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hnkjzyxy</groupId>
                <artifactId>door-access-io</artifactId>
                <version>${door-access-io.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                        <encoding>UTF-8</encoding>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

