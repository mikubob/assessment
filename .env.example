# 仅列出需要注入进程的环境变量，Spring Boot 不会自动加载此文件。
# 请使用部署平台或进程环境配置；不要将真实凭据提交到版本库。
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=9706
LOG_PATH=./logs
DB_URL=jdbc:mysql://127.0.0.1:3306/assessment?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
# 必须复用原服务的 Base64 HS256 密钥（解码至少 32 字节）和 Redis suffix。
JWT_HEADER=Authorization
JWT_SECRET=
AUTH_REDIS_SUFFIX=
JWT_EXPIRE_SECONDS=604800
CORS_ALLOWED_ORIGINS=
IDENTITY_JDBC_ENABLED=true
SCHEMA_CHECK_ENABLED=true
OA_ENABLED=false
OA_BASE_URL=https://dmp.hnkjxy.net.cn
OA_APP_KEY=
OA_APP_SECRET=
SCHEDULE_SYNC_ENABLED=false
SCHEDULE_SYNC_ON_STARTUP=false
SMARTLOCK_ENABLED=false
QUARTZ_AUTO_STARTUP=false
EXAM_REFRESH_ENABLED=false
LOCK_RECONCILE_ENABLED=false
COMMAND_EXPIRY_ENABLED=false
